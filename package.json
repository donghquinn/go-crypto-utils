{
  "name": "go-crypto-utils",
  "productName": "Secure Helper",
  "version": "2.0.0",
  "description": "Desktop utility for AES encryption/decryption, encoding, key, UUID and random string generation",
  "desktopName": "secure-helper.desktop",
  "license": "Apache-2.0",
  "homepage": "https://github.com/donghquinn/go-crypto-utils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donghquinn/go-crypto-utils.git"
  },
  "author": {
    "name": "donghquinn"
  },
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
